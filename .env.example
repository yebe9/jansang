# Copy this file to .env. Keep real keys out of Git, ZIP files and dist/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGIN=https://yebe9.github.io

# Local full-body MotionGPT CPU service only. Leave empty for Gemini-only local use.
# Download weights: python -m motion_service.download_models
# Start service: python -m motion_service.server --port 8765
MOTIONGPT_URL=http://127.0.0.1:8765

# Optional local model/cache tuning. Do not set these in the public Worker.
# MOTIONGPT_MODEL_DIR=C:/path/to/private/model-cache
# MOTIONGPT_CPU_THREADS=4
# MOTIONGPT_INT8=1
